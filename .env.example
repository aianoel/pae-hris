# Aurora — Supabase connection
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never put the service_role key here — it bypasses Row Level Security.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# "anon public" API key (safe for the browser; gated by RLS + Auth).
VITE_SUPABASE_ANON_KEY=

# Optional: set to "true" to let the app insert demo seed rows into empty tables
# on first load. Leave blank/false in production.
VITE_SUPABASE_SEED=
